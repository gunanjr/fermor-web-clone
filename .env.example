# Copy this file to .env.local and fill in values. .env.local is git-ignored; this file is not.
# Placeholders only. Never commit real keys, tokens or passwords.
#
# NOTHING here is required for `npm run dev` or `npm run build`. Every variable below either has
# a hardcoded fallback in the code or only affects one feature (noted per variable). The site
# starts and builds with an empty .env.local.

# ---------------------------------------------------------------------------
# Backend API (fermor-backend, a separate repo/project)
# ---------------------------------------------------------------------------

# Optional. Base URL of the Fermor backend API. Used by currency rates, sign-in/account, the CA
# portal, mutual-funds pages, intake/plan pages and the sitemap's mutual fund URLs.
# Falls back to https://api.fermor.in when unset. Set it to a local backend to develop against
# one, e.g. http://localhost:4000
NEXT_PUBLIC_API_URL=

# Optional. Public origin of this site, used to build shareable plan links on /plan/[token].
# Falls back to https://fermor.in when unset.
NEXT_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Supabase (src/lib/supabase.ts) - only the live gold price pipeline uses this
# ---------------------------------------------------------------------------
# Optional for dev/build: the client falls back to placeholder values so the module still loads.
# Required at runtime only for /api/commodities/* and /api/cron/fetch-metals, which the Gold
# Loan Calculator's live rate depends on (it falls back to a hardcoded rate if that call fails).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Gold price cron (app/api/cron/fetch-metals/route.ts)
# ---------------------------------------------------------------------------

# Required only to call POST /api/cron/fetch-metals. The request must send
# "Authorization: Bearer <this value>". Also set the same value as a GitHub Actions secret
# (CRON_SECRET, plus PRODUCTION_URL) for .github/workflows/fetch-commodities.yml; those are
# separate secret stores from this file and from Vercel.
CRON_SECRET=

# Optional. Gold price providers, tried in this order. If neither is set the cron route returns 502.
METALS_DEV_API_KEY=
GOLDAPI_KEY=

# ---------------------------------------------------------------------------
# Third-party data
# ---------------------------------------------------------------------------

# Optional. GSTIN live lookup (app/api/gst/verify/[gstin]). Server-side only.
# When unset the route returns 503 and the GST search widget falls back to its free client-side
# format and check-digit decode.
GSTIN_CHECK_API_KEY=

# Optional. Webhook (Zapier, Make or any HTTP endpoint) that receives waitlist sign-ups from
# app/api/waitlist. When unset, sign-ups are only logged to the server console.
WAITLIST_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Content generation scripts (scripts/generate-tax-pages.ts, generate-city-tax-pages.ts)
# ---------------------------------------------------------------------------
# Optional. Only read when you run those scripts by hand (npx tsx scripts/...); the app itself,
# `npm run dev` and `npm run build` never touch them. The scripts load .env.local themselves and
# fall back to deterministic content if the keys are missing or rate-limited.

GROQ_API_KEY=
GEMINI_API_KEY=
